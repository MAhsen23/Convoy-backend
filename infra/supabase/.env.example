# Copy this file to infra/supabase/.env on VPS
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

JWT_SECRET=replace_with_strong_jwt_secret
SECRET_KEY_BASE=replace_with_strong_secret_key_base
DB_ENCRYPTION_KEY=70209679729940a5
SUPABASE_ANON_KEY=replace_with_anon_key_jwt
SUPABASE_SERVICE_ROLE_KEY=replace_with_service_role_jwt

SUPABASE_SITE_URL=http://localhost:3000
SUPABASE_PUBLIC_URL=http://SERVER_IP:8000
API_EXTERNAL_URL=http://SERVER_IP:8000

GOTRUE_DISABLE_SIGNUP=false
GOTRUE_MAILER_AUTOCONFIRM=true
GOTRUE_URI_ALLOW_LIST=
JWT_EXPIRY_SECONDS=3600

